# Dynamic Corridor Clearing — Environment Variables
# Copy this to .env and customize

CC_HOST=0.0.0.0
CC_PORT=8000
CC_DB_PATH=corridor_clearing.db
CC_VIZ_MODE=abstract           # "abstract" or "leaflet"
CC_SIM_SPEED=1.0
CC_SIM_DURATION_S=3600.0
CC_MCTS_ITERATIONS=1000
CC_MCTS_HORIZON_S=60.0
CC_MCTS_REPLAN_INTERVAL_S=10.0
CC_MCTS_EXPLORATION_CONSTANT=1.41
